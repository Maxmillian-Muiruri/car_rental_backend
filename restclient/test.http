### Base URL
### http://localhost:3000

##################################
# CAR Endpoints
##################################

###Create a Car

POST http://localhost:3000/cars
Content-Type: application/json

{
  "carModel": "nissans",
  "manufacturer": "Isuzus",
  "year": 2025,
  "color": "black",
  "rentalRate": 50.00,
  "availability": true,
  "locationId": 3
}

#### Get all Cars
GET http://localhost:3000/cars
#
### Get Car by ID
GET http://localhost:3000/cars/1

###  Update Car
 PATCH http://localhost:3000/cars/4
Content-Type: application/json

{
"color": "Red",
"availability": true,
  "locationId": 3
}

### Delete Car
#DELETE http://localhost:3000/car/1
#
###################################
## CUSTOMER Endpoints
###################################
#
###  Create a Customer
POST http://localhost:3000/customer
Content-Type: application/json

{
 "firstName": "John2",
 "lastName": "Doe2",
  "email": "john2.doe@example.com",
  "phoneNumber": "+1234567890",
  "address": "123 Main St, City, State"
}

### Get all Customers

GET http://localhost:3000/customer

### Get Customer by ID
GET http://localhost:3000/customer/2

### Update Customer
PATCH http://localhost:3000/customer/2
Content-Type: application/json

{
"phoneNumber": "+254710795876"
}

### Delete Customer
DELETE http://localhost:3000/customer/1

###################################
## RENTAL Endpoints
###################################

### Create a Rental
POST http://localhost:3000/rental
Content-Type: application/json

{
 "carId": 1,
  "customerId": 2,
  "rentalStartDate": "2025-12-15",
  "rentalEndDate": "2026-01-20",
  "totalAmount": 250.00
}

### Get all Rentals
GET http://localhost:3000/rental

### Get Rental by ID
GET http://localhost:3000/rental/1

### Update Rental
PATCH http://localhost:3000/rental/1
Content-Type: application/json

{
"totalAmount": 300.00
}

### Delete Rental
DELETE http://localhost:3000/rental/1

###################################
## PAYMENT Endpoints
###################################

### Create Payment
POST http://localhost:3000/payment
Content-Type: application/json

{
 "rentalId": 1,
  "amount": 100.00,
  "paymentDate": "2026-01-16",
  "paymentMethod": "Credit Card"
}

### Get all Payments
GET http://localhost:3000/payment

### Get Payment by ID
GET http://localhost:3000/payment/3

### Get Payments by Rental ID
GET http://localhost:3000/payment/rental/1

### Update Payment
PATCH http://localhost:3000/payment/3
Content-Type: application/json

{
"amount": 150.00
}

### Delete Payment
DELETE http://localhost:3000/payment/1

