### Base URL
### http://localhost:3000

##################################
# CAR Endpoints
##################################

###Create a Car

POST http://localhost:3000/car
Content-Type: application/json

{
  "carModel": "Camry",
  "manufacturer": "Toyota",
  "year": 2023,
  "color": "Silver",
  "rentalRate": 50.00,
  "availability": true
}

#### Get all Cars
#GET http://localhost:3000/car
#
####Get Car by ID
#GET http://localhost:3000/car/1
#
## Update Car
#PATCH http://localhost:3000/car/1
#Content-Type: application/json
#
#{
#"color": "Red",
#"availability": false
#}
#
## Delete Car
#DELETE http://localhost:3000/car/1
#
